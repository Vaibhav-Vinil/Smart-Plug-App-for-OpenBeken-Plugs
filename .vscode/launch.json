{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Smart Plug App (Phone + Backend)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/smart_plug_app/lib/main.dart",
      "cwd": "${workspaceFolder}/smart_plug_app",
      "preLaunchTask": "Start Global Backend",
      "toolArgs": [
        "--device-timeout",
        "120"
      ]
    },
    {
      "name": "Smart Plug App (Emulator + Backend)",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/smart_plug_app/lib/main.dart",
      "cwd": "${workspaceFolder}/smart_plug_app",
      "deviceId": "emulator-5554",
      "preLaunchTask": "Start Global Backend and Emulator",
      "toolArgs": [
        "--device-timeout",
        "120"
      ]
    }
  ]
}
